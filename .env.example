# Keep 127.0.0.1 for access from this computer only. Use 0.0.0.0 for trusted LAN access.
QUANT_HOME_BIND_HOST=127.0.0.1
QUANT_HOME_BIND_PORT=8000
QUANT_HOME_ENVIRONMENT=development
QUANT_HOME_HTTPS_ENABLED=false
QUANT_HOME_MAX_BACKGROUND_JOBS=3

QUANT_DB_PASSWORD=replace-with-a-long-random-database-password
QUANT_HOME_INITIAL_ADMIN_USERNAME=admin
QUANT_HOME_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
